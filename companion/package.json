{
  "name": "miso-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/flatten.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:tuning": "node --import ./scripts/ts-resolve.mjs scripts/check-tuning.mjs",
    "check:firmware": "python3 scripts/check-firmware-pitch.py",
    "check:colors": "python3 scripts/check-firmware-colors.py",
    "check:all": "npm run check && npm run check:tuning && npm run check:firmware && npm run check:colors"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "dependencies": {
    "meantonal": "^0.13.0"
  }
}
